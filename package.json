{
  "name": "forenshield",
  "version": "2.0.0",
  "description": "Integrated Secure Data Erasure & Advanced Forensic File Recovery — Smart India Hackathon 2026",
  "private": true,
  "license": "MIT",
  "keywords": [
    "digital-forensics",
    "data-erasure",
    "file-recovery",
    "cybersecurity",
    "NIST",
    "DoD",
    "SIH-2026",
    "forensic-tools",
    "data-sanitization",
    "hash-analyzer"
  ],
  "homepage": ".",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/forenshield.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/forenshield/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "npx serve . --listen 8080",
    "dev": "npx serve . --listen 8080 --no-clipboard",
    "lint:html": "npx htmlhint \"**/*.html\" --ignore node_modules",
    "lint:css": "npx stylelint \"css/**/*.css\"",
    "validate": "npm run lint:html && npm run lint:css",
    "format": "npx prettier --write \"**/*.{html,css,js,json,md}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "serve": "^14.0.0"
  },
  "browserslist": [
    "Chrome >= 90",
    "Firefox >= 88",
    "Edge >= 90",
    "Safari >= 14"
  ],
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "endOfLine": "lf"
  }
}
